<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_delivery_document_qr" inherit_id="stock.report_delivery_document">
            <xpath expr="//div[hasclass('page')]" position="inside">
                <div class="row" t-if="o.qr_code_image and o.picking_type_code == 'outgoing'">
                    <div class="col-12" style="text-align: right; margin: 20px 0;">
                        <div style="display: inline-block; text-align: center; border: 2px solid #000; padding: 10px; background-color: #f9f9f9;">
                            <div style="margin-bottom: 5px; font-weight: bold; font-size: 12px;">
                                Delivery Information QR Code
                            </div>
                            <img t-field="o.qr_code_image"
                                 t-options="{'widget': 'image'}"
                                 style="width: 120px; height: 120px; border: 1px solid #ccc;" />
                            <div style="margin-top: 5px; font-size: 10px; color: #666;">
                                Scan for CSV Data
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
